PORT=3000
NODE_ENV=development
# 프론트 Origin(정확히 scheme://host:port, 끝 슬래시 없음). 여러 개면 쉼표로 구분.
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google Cloud Console의 "웹 애플리케이션" OAuth 클라이언트 ID (프론트 GIS와 같은 값)
# ID 토큰 검증 방식이므로 Client Secret / redirect URI는 필요 없다.
GOOGLE_CLIENT_ID=

# 32바이트 이상 난수. 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=codeml-api
JWT_AUDIENCE=codeml-web

# 채점 실행 방식. docker(기본, 격리된 컨테이너) | local(서버에서 바로 실행, 격리 없음 — 개발용, 운영에서는 거부됨)
# docker 방식은 Docker가 실행 중이어야 하고, 처음 한 번 이미지를 받아 둬야 한다: docker pull python:3.12-slim
# JUDGE_RUNNER=docker
# JUDGE_DOCKER_IMAGE=python:3.12-slim

# (JUDGE_RUNNER=local 전용) 채점용 파이썬 실행 파일. 생략하면 Windows=python, 그 외=python3
# PYTHON_BIN=

# 생략 시 NODE_ENV=production 이면 true. 로컬 http 개발은 false.
# COOKIE_SECURE=
